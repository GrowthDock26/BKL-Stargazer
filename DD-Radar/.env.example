# DD-Radar – Konfigurationsvorlage
# Diese Datei als ".env" kopieren und Werte eintragen.
# Die echte .env NIEMALS weitergeben oder in ein Repository einchecken.

# Pflichtfeld: API-Schluessel des LOGICC-Kontos der Kanzlei
LOGICC_API_KEY=sk-...

# Endpunkt (einzig zulaessiger KI-Host; wird beim Start geprueft)
API_ENDPOINT=https://api.logicc.io/v1

# Modell fuer die Dokumentklassifikation
# gemini-2.5-flash = guenstig und schnell; gpt-4o = genauer bei Vertragstexten
MODEL=gemini-2.5-flash

# Modell fuer gescannte PDFs und Bilddateien (Vision)
VISION_MODEL=gpt-4o

# Pruefprofil: SEED | VC | MA
PROFIL=VC

# Gescannte PDFs per Bilderkennung auswerten (1 = ja)
USE_VISION=1

# E-Mail, Telefon und IBAN vor dem Versand maskieren (1 = ja)
ANONYMISIEREN=0

# Kostenbremse: nur die ersten N Dokumente analysieren (0 = alle)
MAX_DOCS=0

# Betriebsarten fuer Tests
USE_MOCK=0
OFFLINE_MODE=0
