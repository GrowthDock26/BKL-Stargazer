# BKL Legal OS — Backend Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# =====================================================================
# Server
# =====================================================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=1

# =====================================================================
# LLM — SOLE EGRESS: LOGICC (api.logicc.io)
# DO NOT set OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY.
# Any such variable is ignored and their presence will trigger a warning.
# =====================================================================
LOGICC_API_KEY=replace-with-your-logicc-key
LOGICC_EMBEDDING_MODEL=gemini-embedding-001

# =====================================================================
# Supabase (use EU region: eu-central-1 or self-hosted in EU)
# =====================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# =====================================================================
# Object Storage: Cloudflare R2 (EU) ODER AWS S3 eu-central-1
# =====================================================================
#
# ── Option A: Hetzner Object Storage (DE/FI — günstig, einfach) ───────
#
#  1. console.hetzner.cloud → Object Storage → "Create bucket"
#     Location: Nürnberg (nbg1), Falkenstein (fsn1) oder Helsinki (hel1)
#     Name: bkl-legal-os
#
#  2. "S3 credentials" → "Generate credentials"
#     → Access Key und Secret Key notieren
#
#  Endpoint:  https://nbg1.your-objectstorage.com   (Nürnberg)
#         or  https://fsn1.your-objectstorage.com   (Falkenstein)
#         or  https://hel1.your-objectstorage.com   (Helsinki)
#  R2_REGION: eu-central   (für alle Hetzner-Standorte)
#
# ── Option B: IONOS Object Storage (Frankfurt) ────────────────────────
#
#  1. cloud.ionos.de → Object Storage → "Bucket erstellen"
#     Standort: Frankfurt (DE)
#     Name: bkl-legal-os
#
#  2. Object Storage → "API-Keys" → "Key hinzufügen"
#     → Access Key und Secret Key notieren
#
#  Endpoint:  https://s3-eu-central-1.ionoscloud.com
#  R2_REGION: eu-central-1
#
# ── Option C: Cloudflare R2 (keine Egress-Kosten) ─────────────────────
#
#  1. dash.cloudflare.com → R2 Object Storage → "Create bucket"
#     Location: "European Union" (Pflicht für DSGVO!)
#
#  2. R2 → Overview → "Manage R2 API Tokens" → "Create API Token"
#     Permissions: "Object Read & Write", Bucket: bkl-legal-os
#     → Access Key ID und Secret Access Key notieren
#
#  3. Account-ID: R2 → Overview → rechte Spalte "Account ID"
#
#  Endpoint:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#  R2_REGION: leer lassen (nutzt "auto")
#
# ── Option D: AWS S3 Frankfurt ────────────────────────────────────────
#
#  Endpoint:  https://s3.eu-central-1.amazonaws.com
#  R2_REGION: eu-central-1
#
# ── Preisvergleich (ca., Stand 2026) ──────────────────────────────────
#  Hetzner:   ~0,005 €/GB/Monat  + 0 € Egress intern / 0,01 € extern
#  IONOS:     ~0,007 €/GB/Monat  + geringe Egress-Kosten
#  R2:        ~0,015 €/GB/Monat  + 0 € Egress (kein Egress-Preismodell)
#  AWS S3:    ~0,023 €/GB/Monat  + 0,09 €/GB Egress
#
# ── Aktive Konfiguration: Hetzner Object Storage Falkenstein (FSN1) ──
R2_ENDPOINT_URL=https://fsn1.your-objectstorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bkl-legal-os
R2_REGION=eu-central

# Alternativen (auskommentiert):
# Hetzner NBG:   R2_ENDPOINT_URL=https://nbg1.your-objectstorage.com  R2_REGION=eu-central
# IONOS FRA:     R2_ENDPOINT_URL=https://s3-eu-central-1.ionoscloud.com  R2_REGION=eu-central-1
# Cloudflare R2: R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com  R2_REGION=(leer)
# AWS S3 FRA:    R2_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com  R2_REGION=eu-central-1

# =====================================================================
# EU SMTP (use Hetzner Mail, mailcow, or self-hosted Postfix in EU)
# NOT Resend/SendGrid without verifying EU data residency.
# =====================================================================
SMTP_HOST=mail.example.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kanzlei@example.de
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="BKL Kanzlei <kanzlei@example.de>"

# =====================================================================
# Security
# =====================================================================
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
USER_API_KEYS_ENCRYPTION_SECRET=replace-with-long-random-secret

# =====================================================================
# Optional — Onboarding & Scheduler
# =====================================================================
# ONBOARDING_REVIEW_GATE=true       # Default: true (attorney must approve before send)
# SCHEDULER_INTERVAL_MS=300000      # Default: 5 minutes

# Pfad zu pdftoppm (Poppler), falls es nicht in PATH liegt. Wird zum Rastern
# gescannter und handschriftlicher PDFs vor der Bilderkennung genutzt.
# Unter Windows typischerweise C:\poppler\bin\pdftoppm.exe
# PDFTOPPM_PATH=

# Fristen-Benachrichtigungen (Vorfrist + Ablauf) — kanzleiinterne
# Sammeladresse(n), komma-separiert. NUR interne Postfächer eintragen: die
# E-Mails enthalten Aktenzeichen und Kurzbezeichnung des Mandats.
#
# Ohne diese Variable wird ausschließlich der auf der Akte hinterlegte
# zuständige Anwalt benachrichtigt. Ist auch dieser nicht gesetzt, kann keine
# Benachrichtigung versandt werden — der Scheduler protokolliert das dann als
# Fehler und versucht es beim nächsten Lauf erneut.
# FRISTEN_NOTIFY_EMAIL=sekretariat@example.de,fristen@example.de

# =====================================================================
# BLOCKED VARIABLES — do not set; system will warn/error if present
# =====================================================================
# ANTHROPIC_API_KEY  — BLOCKED: no Anthropic egress allowed
# CLAUDE_API_KEY     — BLOCKED
# OPENAI_API_KEY     — BLOCKED: no direct OpenAI egress allowed
# GEMINI_API_KEY     — BLOCKED: no direct Google egress allowed
# RESEND_API_KEY     — BLOCKED: replaced by EU SMTP

# ---------------------------------------------------------------------------
# Rechtsprechung — Open Legal Data (Instanzgerichte, ODbL)
#
# Die robots.txt der Quelle verlangt einen User-Agent, der den Betreiber
# benennt oder einen Kontaktweg enthaelt. Ohne Eintrag greift ein Standardwert
# mit der Kanzleiadresse. Kein Schluessel noetig, keine Registrierung.
# ---------------------------------------------------------------------------
OPEN_LEGAL_DATA_USER_AGENT="BKL-Legal-OS/1.0 (Kanzleisoftware; Kontakt: kanzlei@bkl-law.de)"
