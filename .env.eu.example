# =============================================================================
# BKL Legal OS — Umgebungsvariablen (Vorlage)
# =============================================================================
# Kopieren Sie diese Datei nach ".env.eu" und füllen Sie alle Werte aus.
# Die ".env.eu"-Datei NIEMALS in Git einchecken (steht in .gitignore).
#
# Verwendung:
#   docker compose --env-file .env.eu -f docker-compose.eu.yml up -d
# =============================================================================


# =============================================================================
# 1. FRONTEND-URL
# =============================================================================

# Öffentlich erreichbare URL der Anwendung (für CORS und E-Mail-Links)
FRONTEND_URL=https://legal.bkl-law.de


# =============================================================================
# 2. KI-ASSISTENT (LOGICC)
# =============================================================================
# Einziger erlaubter LLM-Anbieter. API-Schlüssel von: https://logicc.io
# Pflicht — ohne diesen Schlüssel startet der Backend-Server nicht.

LOGICC_API_KEY=lc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding-Modell (Standard reicht aus)
LOGICC_EMBEDDING_MODEL=gemini-embedding-001


# =============================================================================
# 3. DATENBANK (Supabase)
# =============================================================================
# Option A: Supabase Cloud EU (https://app.supabase.com → Projekt → Settings → API)
#   Region beim Anlegen: "Europe West" oder "Frankfurt (eu-central-1)"
#
# Option B: Selbst gehostetes Supabase auf EU-Server
#   → https://supabase.com/docs/guides/self-hosting/docker

# Projekt-URL (endet auf .supabase.co oder eigene Domain)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Service-Role-Schlüssel (geheimer Backend-Schlüssel, NICHT der Anon-Key!)
# Supabase Dashboard → Settings → API → "service_role" key
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# Anon-Schlüssel (für das Frontend, öffentlich nutzbar)
# Supabase Dashboard → Settings → API → "anon public" key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# Nur bei Docker-Compose-Setup:
POSTGRES_PASSWORD=sicheres-passwort-hier-eintragen
POSTGRES_DB=bkl_legal_os


# =============================================================================
# 4. DATEISPEICHER
# =============================================================================
# Pflicht für Dokument-Upload (Onboarding-PDFs, Mandantendokumente).
#
# ── Option A: Hetzner Object Storage (empfohlen — DE/FI, günstig) ──────────
#
#   1. console.hetzner.cloud → Object Storage → "Create bucket"
#      Location: Nürnberg (nbg1) oder Falkenstein (fsn1)
#      Name: bkl-legal-os
#   2. "S3 credentials" → "Generate credentials"
#      → Access Key und Secret Key notieren
#
# R2_ENDPOINT_URL=https://nbg1.your-objectstorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bkl-legal-os
# R2_REGION=eu-central
#
# ── Option B: IONOS Object Storage (Frankfurt) ───────────────────────────────
#
#   1. cloud.ionos.de → Object Storage → "Bucket erstellen"
#      Standort: Frankfurt (DE)
#   2. Object Storage → "API-Keys" → "Key hinzufügen"
#      → Access Key und Secret Key notieren
#
# R2_ENDPOINT_URL=https://s3-eu-central-1.ionoscloud.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bkl-legal-os
# R2_REGION=eu-central-1
#
# ── Option C: Cloudflare R2 (keine Egress-Kosten) ────────────────────────────
#
#   1. dash.cloudflare.com → R2 → "Create bucket"
#      Location: "European Union"
#   2. R2 → "Manage R2 API Tokens" → "Create API Token"
#      Permissions: Object Read & Write, Bucket: bkl-legal-os
#   3. Account-ID: R2 → Overview → rechte Seite
#
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bkl-legal-os
# R2_REGION=          ← leer lassen
#
# ── Option D: AWS S3 Frankfurt ───────────────────────────────────────────────
#
# R2_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bkl-legal-os-prod
# R2_REGION=eu-central-1
#
# ── Preisvergleich (ca., Stand 2026) ─────────────────────────────────────────
#   Hetzner:  ~0,005 €/GB/Mon  •  Egress: 0 € intern / 0,01 € extern
#   IONOS:    ~0,007 €/GB/Mon  •  geringe Egress-Kosten
#   R2:       ~0,015 €/GB/Mon  •  kein Egress-Preismodell
#   AWS S3:   ~0,023 €/GB/Mon  •  0,09 €/GB Egress
#
# ── Aktive Konfiguration: Hetzner Object Storage Falkenstein (FSN1) ──────────
R2_ENDPOINT_URL=https://fsn1.your-objectstorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bkl-legal-os
R2_REGION=eu-central

# Alternativen (auskommentiert):
# Hetzner NBG:   R2_ENDPOINT_URL=https://nbg1.your-objectstorage.com  R2_REGION=eu-central
# IONOS FRA:     R2_ENDPOINT_URL=https://s3-eu-central-1.ionoscloud.com  R2_REGION=eu-central-1
# Cloudflare R2: R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com  R2_REGION=(leer)
# AWS S3 FRA:    R2_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com  R2_REGION=eu-central-1


# =============================================================================
# 5. E-MAIL (SMTP)
# =============================================================================
# EU-SMTP-Server erforderlich (DSGVO-Datenresidenz).
#
# Empfohlene Anbieter (alle EU-gehostet):
#   - Hetzner Mail:    smtp.your-server.de  Port 587
#   - mailcow (selbst gehostet auf Hetzner/OVH)
#   - IONOS (DE):      smtp.ionos.de        Port 587
#
# NICHT verwenden: Resend, SendGrid, Mailgun (US-Rechenzentren ohne AVV).

SMTP_HOST=smtp.your-server.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kanzlei@bkl-law.de
SMTP_PASS=smtp-passwort-hier
SMTP_FROM="BKL Rechtsanwälte <kanzlei@bkl-law.de>"


# =============================================================================
# 6. SICHERHEITSSCHLÜSSEL
# =============================================================================
# Zufällige, geheime Zeichenketten. Generieren mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Zum Signieren von Download-URLs (verhindert Manipulation)
DOWNLOAD_SIGNING_SECRET=

# Zum Verschlüsseln gespeicherter API-Schlüssel in der Datenbank
USER_API_KEYS_ENCRYPTION_SECRET=


# =============================================================================
# 7. ANWENDUNGS-EINSTELLUNGEN
# =============================================================================

# Interne Backend-URL (nur für Docker-Compose-Setup)
BACKEND_INTERNAL_URL=http://backend:3001

# Fristen-Scheduler: Prüfintervall in Millisekunden (Standard: 5 Minuten)
SCHEDULER_INTERVAL_MS=300000

# Onboarding-Review-Gate: "true" = Anwalt muss vor Versand freigeben (empfohlen)
ONBOARDING_REVIEW_GATE=true
